# Pocket CISO — local configuration. Copy to .env, replace every placeholder, then load it into BOTH terminals:
#   set -a; source .env; set +a
# .env is gitignored; never commit real values.

# HMAC secret for session tokens and the audit anchor (>= 32 random characters, e.g. `openssl rand -hex 32`)
POCKET_CISO_SECRET=<replace-with-at-least-32-random-characters>
# Login passwords for L2 (IT-Admin) and L3 (CISO), >= 14 characters each; L1 has no password
POCKET_CISO_L2_PASSWORD=<replace-with-l2-password-min-14-chars>
POCKET_CISO_L3_PASSWORD=<replace-with-l3-password-min-14-chars>

# Runtime data (DB, vectors) and the watched inbox; defaults: ./data and ./data/inbox
POCKET_CISO_DATA_DIR=<absolute-path>/Pocket-CISO/data
WATCHED_INBOX_DIR=<absolute-path>/Pocket-CISO/data/inbox

# Ollama (optional; without it the engine returns labelled search hits only)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
